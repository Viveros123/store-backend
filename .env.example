# Copiar este archivo a .env y completar los valores reales.
# .env NUNCA se sube al repo (está en .gitignore).

# Cadena de conexión de Neon (Dashboard -> Connect -> Connection string)
# Ejemplo: postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clave para firmar los tokens JWT. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Minutos de validez del token de acceso (por defecto 1 dia)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
